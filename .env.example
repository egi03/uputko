# Kopiraj u .env i popuni. .env se nikad ne commita.

# --- Zajedničko (backend) ---
# Tajna koju oba profila šalju u zaglavlju X-Tool-Secret (nasumičan niz, npr. `openssl rand -hex 32`)
TOOL_SECRET=
DATABASE_URL=sqlite:///./data/uputko.db
HTTP_USER_AGENT=Uputko/0.3 (+https://github.com/egi03/uputko)
TIMEZONE=Europe/Zagreb
LOG_LEVEL=INFO
# false na poslužitelju kojem HALMED ne odgovara (npr. Google Cloud): bazu lijekova tada šalje
# računalo kojem odgovara, `uv run python scripts/push_halmed.py <korisnik@poslužitelj>` (vidi README)
HALMED_DOWNLOAD=true
# Dopušteni izvori za CORS: React aplikacija (premium) i open stranica
FRONTEND_ORIGIN=http://localhost:5173
OPEN_ORIGIN=http://localhost:7860

# --- Premium profil: ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Neobavezno: ID postojeće tajne s vrijednošću TOOL_SECRET. Ako je prazno,
# backend/scripts/elevenlabs_tools.py --apply sam stvori tajnu i koristi nju.
ELEVENLABS_TOOL_SECRET_ID=
# Javni HTTPS URL backenda za webhook alate (tunel u razvoju, domena u produkciji)
PUBLIC_BASE_URL=https://example.trycloudflare.com

# --- Premium profil: produkcija (Docker, Caddy) ---
# Domena za HTTPS (npr. uputko.hr); prazno = samo http://localhost. Compose je čita samo uz
# `docker compose --env-file .env -f deploy/docker-compose.yml ...` (vidi README).
DOMAIN=

# --- Premium profil: frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
# Javna adresa aplikacije (npr. https://uputko.hr): apsolutne poveznice za pregled kad se link podijeli
VITE_PUBLIC_URL=

# --- Open profil: Pipecat bot ---
# groq: Whisper i gpt-oss na Groqu (treba GROQ_API_KEY)
# local: sve na ovom računalu, bez ključeva: Whisper (faster-whisper) i jezični model u Ollami
OPEN_MODE=groq
GROQ_API_KEY=
# Modeli na Groqu; STT: whisper-large-v3-turbo ili whisper-large-v3
OPEN_STT_MODEL=whisper-large-v3-turbo
# LLM: openai/gpt-oss-120b ili openai/gpt-oss-20b
OPEN_LLM_MODEL=openai/gpt-oss-120b
# Sinteza govora na procesoru (Coqui VITS za hrvatski)
OPEN_TTS_MODEL=tts_models/hr/cv/vits
# Adresa backenda za pozive alata iz bota (u Docker Composeu: http://backend:8000)
TOOLS_BASE_URL=http://localhost:8000
# Adresa backenda s koje open stranica u pregledniku dohvaća kartice
OPEN_PUBLIC_API_URL=http://localhost:8000
OPEN_PORT=7860
# Adresa na kojoj bot sluša: samo ovo računalo; 0.0.0.0 za pristup s drugog računala
OPEN_HOST=127.0.0.1
# Najviše istodobnih razgovora (svaki koristi procesor za sintezu govora)
OPEN_MAX_SESSIONS=4
# Razina loga open bota; na DEBUG Pipecat ispisuje i ono što korisnik kaže, pa ostaje INFO
OPEN_LOG_LEVEL=INFO
# Pauza nakon koje se smatra da je korisnik završio rečenicu (sekunde)
OPEN_USER_SPEECH_TIMEOUT=1.0
# Opcionalno: STUN/TURN poslužitelji za pristup s drugog računala, odvojeni zarezom
OPEN_ICE_SERVERS=
# Samo za OPEN_MODE=local
OPEN_LOCAL_STT_MODEL=large-v3-turbo
# auto: NVIDIA grafička kartica ako radi, inače procesor (sporo); cuda; cpu
OPEN_LOCAL_STT_DEVICE=auto
# qwen3:8b uz Whisper stane u 12 GB grafičke memorije; qwen3:14b treba oko 16 GB
OPEN_OLLAMA_MODEL=qwen3:8b
OPEN_OLLAMA_URL=http://localhost:11434/v1
OPEN_OLLAMA_CTX=12288
